{
  "name": "codecoach",
  "displayName": "CodeCoach",
  "description": "A virtual FRC software mentor that coaches rather than does.",
  "version": "0.0.0",
  "private": true,
  "publisher": "codecoach",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/ElliotScher/CodeCoach.git"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onView:codecoach.chat",
    "workspaceContains:**/build.gradle",
    "workspaceContains:**/pyproject.toml"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codecoach",
          "title": "CodeCoach",
          "icon": "media/codecoach.svg"
        }
      ]
    },
    "views": {
      "codecoach": [
        {
          "type": "webview",
          "id": "codecoach.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "codecoach.openChat",
        "title": "Open Chat",
        "category": "CodeCoach"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "dev": "node scripts/dev.mjs",
    "test:vscode": "node test/run.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@codecoach/ui": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.105.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0"
  }
}
