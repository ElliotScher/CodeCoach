{
  "name": "codecoach",
  "private": true,
  "description": "A virtual FRC software mentor that coaches rather than does.",
  "license": "BSD-3-Clause",
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter \"./apps/*\" run build",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && tsc -p apps/cli && tsc -p apps/vscode",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scripts": "node --test \"scripts/test/*.test.mjs\"",
    "test:vscode": "pnpm --filter ./apps/vscode run build && pnpm --filter ./apps/vscode run test:vscode",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:vscode": "pnpm --filter ./apps/vscode run dev",
    "package:vscode": "pnpm --filter ./apps/vscode run package",
    "fixtures": "node scripts/fixtures.mjs",
    "codecoach": "node --conditions=@codecoach/source --import tsx apps/cli/src/main.ts",
    "clean": "tsc -b --clean",
    "doctor": "node scripts/doctor.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.105.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@codecoach/ui": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
